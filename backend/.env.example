# Keep the real key only in backend/.env. Never add it to extension files.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Optional after you know the Chrome extension ID. Use comma-separated values for multiple origins.
# CORS_ORIGINS=chrome-extension://your-extension-id
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000
